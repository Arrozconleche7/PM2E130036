<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E130036.EnviosPage"
             Title="Envíos"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Encabezado oscuro -->
            <Border BackgroundColor="#1F2937" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="CALCULADORA DE ENVIOS"
                       TextColor="White" FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>

            <!-- 1. Descripción del paquete -->
            <Label Text="Descripcion del paquete" TextColor="#374151" FontSize="14" />
            <Entry x:Name="txtDescripcion"
                   Placeholder="Documento o paquete ejemplo"
                   TextColor="#1F2937" PlaceholderColor="#9CA3AF" />

            <!-- 2. Peso del paquete -->
            <Label Text="Peso del paquete(kg)" TextColor="#374151" FontSize="14" />
            <Entry x:Name="txtPeso"
                   Placeholder="2.5"
                   Keyboard="Numeric"
                   TextColor="#1F2937" PlaceholderColor="#9CA3AF" />

            <!-- 3. Zona de destino -->
            <Label Text="Zona de destino" TextColor="#374151" FontSize="14" />
            <Picker x:Name="pckZona"
                    Title="Seleccione la zona"
                    TextColor="#1F2937" TitleColor="#9CA3AF">
                <Picker.Items>
                    <x:String>Zona local</x:String>
                    <x:String>Zona nacional</x:String>
                    <x:String>Zona internacional</x:String>
                </Picker.Items>
            </Picker>

            <!-- 4. Servicio Express -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <CheckBox x:Name="chkExpress" Color="#1F2937" />
                <Label Text="Servicio Express" TextColor="#374151" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Botón Principal -->
            <Button x:Name="btnCalcular"
                    Text="Calcular Envio"
                    BackgroundColor="#1F2937" TextColor="White"
                    FontAttributes="Bold" CornerRadius="8"
                    Clicked="OnCalcularClicked" />

            <!-- Tarjeta de Resultado (Inicia Oculta) -->
            <Border x:Name="brdResultado" IsVisible="False"
                    Padding="20" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Resultado" TextColor="#374151" FontSize="16" />

                    <Label x:Name="lblCostoTotal" FontSize="20" FontAttributes="Bold"
                           TextColor="#1F2937" />

                    <Label x:Name="lblDetalle" FontSize="14"
                           TextColor="#374151" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>